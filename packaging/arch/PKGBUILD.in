# Local snapshot package. Generated by tools/make_arch_snapshot.sh.
pkgname=diffractor-native-preview
pkgver=0.1.0
pkgrel=1
pkgdesc='Experimental native Linux frontend for Diffractor'
arch=('x86_64')
url='https://github.com/tzerokyi/diffractor'
license=('LGPL-3.0-or-later')
depends=('glibc' 'gcc-libs' 'openssl' 'zlib' 'brotli' 'zstd' 'fontconfig' 'wayland' 'libxkbcommon' 'libx11' 'libxcb' 'libxcursor' 'libxi' 'libxrandr' 'libglvnd' 'libvlc' 'vlc-plugins-base' 'vlc-plugin-ffmpeg')
makedepends=('cmake' 'ninja' 'nasm' 'rust' 'python' 'git' 'pkgconf')
options=('!debug' '!lto')
source=("diffractor-${pkgver}.tar.zst")
sha256sums=('@SNAPSHOT_SHA256@')

build() {
    cd "$srcdir/diffractor"
    cmake -S . -B tmp/linux-build -G Ninja -DCMAKE_BUILD_TYPE=Release
    cmake --build tmp/linux-build --parallel "${DIFFRACTOR_JOBS:-6}"
    export DIFFRACTOR_BRIDGE_DIR="$PWD/tmp/linux-build"
    cargo build --locked --release --manifest-path rust/diffractor-ui/Cargo.toml
}

check() {
    cd "$srcdir/diffractor"
    ./tmp/linux-build/diffractor /test
    export DIFFRACTOR_BRIDGE_DIR="$PWD/tmp/linux-build"
    export LD_LIBRARY_PATH="$PWD/tmp/linux-build${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    cargo test --locked --manifest-path rust/diffractor-core/Cargo.toml
    cargo test --locked --manifest-path rust/diffractor-ui/Cargo.toml
}

package() {
    cd "$srcdir/diffractor"
    local libdir="$pkgdir/usr/lib/$pkgname"
    install -Dm755 rust/diffractor-ui/target/release/diffractor-ui "$libdir/diffractor-ui"
    install -Dm755 tmp/linux-build/diffractor "$libdir/diffractor"
    install -Dm755 tmp/linux-build/libdiffractor_linux_bridge.so "$libdir/libdiffractor_linux_bridge.so"
    install -Dm755 packaging/arch/diffractor-native-preview "$pkgdir/usr/bin/diffractor-native-preview"
    install -Dm644 packaging/arch/diffractor-native-preview.desktop "$pkgdir/usr/share/applications/diffractor-native-preview.desktop"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 COPYING.GPLv3 "$pkgdir/usr/share/licenses/$pkgname/COPYING.GPLv3"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    for data in location-countries.txt location-places.txt location-states.txt; do
        install -Dm644 "exe/$data" "$libdir/$data"
    done
    install -d "$libdir/languages" "$libdir/dictionaries"
    cp -a exe/languages/. "$libdir/languages/"
    cp -a exe/dictionaries/. "$libdir/dictionaries/"
}
